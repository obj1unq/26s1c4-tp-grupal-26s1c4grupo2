import wollok.game.*
import src.enemigo.gestor.*
import src.enemigo.tipos.dron.*
import src.enemigo.tipos.camara.*
import src.enemigo.tipos.sabueso.*

describe "GestorEnemigos - alertarCercaDe" {
  test "alerta al dron mas cercano a la posicion dada, dentro del rango" {
    game.clear()
    const gestor = new GestorEnemigos()
    const cercano = new Dron(position = game.at(5, 5))
    const lejano = new Dron(position = game.at(20, 20))
    gestor.agregar(cercano)
    gestor.agregar(lejano)

    gestor.alertarCercaDe(game.at(6, 5), 6)

    assert.that(cercano.movimiento().tieneUltima())
    assert.notThat(lejano.movimiento().tieneUltima())
  }

  test "no alerta a nadie si el dron mas cercano igual esta fuera de rango" {
    game.clear()
    const gestor = new GestorEnemigos()
    const lejano = new Dron(position = game.at(20, 20))
    gestor.agregar(lejano)

    gestor.alertarCercaDe(game.at(6, 5), 6)

    assert.notThat(lejano.movimiento().tieneUltima())
  }

  test "no hace nada si todavia no hay enemigos agregados" {
    const gestor = new GestorEnemigos()
    assert.doesNotThrowException({ gestor.alertarCercaDe(game.at(0, 0), 6) })
  }

  test "ignora a una camara mas cercana y alerta al dron, aunque este mas lejos" {
    game.clear()
    const gestor = new GestorEnemigos()
    const camara = new Camara(position = game.at(5, 5))
    const dron = new Dron(position = game.at(9, 5))
    gestor.agregar(camara)
    gestor.agregar(dron)

    gestor.alertarCercaDe(game.at(6, 5), 6)

    assert.that(dron.movimiento().tieneUltima())
  }

  test "ignora a un sabueso mas cercano y alerta al dron, aunque este mas lejos" {
    game.clear()
    const gestor = new GestorEnemigos()
    const sabueso = new Sabueso(position = game.at(5, 5))
    const dron = new Dron(position = game.at(9, 5))
    gestor.agregar(sabueso)
    gestor.agregar(dron)

    gestor.alertarCercaDe(game.at(6, 5), 6)

    assert.that(dron.movimiento().tieneUltima())
  }

  test "no alerta a nadie si el unico enemigo cercano es una camara" {
    game.clear()
    const gestor = new GestorEnemigos()
    const camara = new Camara(position = game.at(5, 5))
    gestor.agregar(camara)

    assert.doesNotThrowException({ gestor.alertarCercaDe(game.at(6, 5), 6) })
  }
}
