import wollok.game.*
import src.enemigoprueba.mapa.mapa.*
import src.enemigoprueba.jugador.player.*
import src.enemigoprueba.enemigos.gestor.*
import src.enemigoprueba.trampas.trampa.*

program juego {
  game.title("Laberinto")
  game.width(20)
  game.height(20)
  game.cellSize(32)
  game.boardGround("fondo2.jpg")

  mapaBuilder.setup()
  game.addVisual(player)
  gestorEnemigos.setup()

  const alambre = new AlambreDePua(position = game.at(12, 4), gestor = gestorEnemigos)
  game.addVisual(alambre)

  keyboard.right().onPressDo({ player.moveRight() })
  keyboard.left().onPressDo({ player.moveLeft() })
  keyboard.up().onPressDo({ player.moveUp() })
  keyboard.down().onPressDo({ player.moveDown() })
  keyboard.space().onPressDo({
    if (player.estaEscondido()) {
      player.salir()
    } else {
      player.esconderse()
    }
  })

  game.onTick(500, "enemies", {
    gestorEnemigos.actualizar(player)
    alambre.verificar(player)
  })

  game.start()
}
